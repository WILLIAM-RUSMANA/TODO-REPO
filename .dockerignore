cat << 'EOF' > .dockerignore
# Dependencies & Package Managers
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Cache
.next
out
build
.vercel

# Environment Files & Secrets
.env
.env.*
*.pem

# IDEs, System Files & Debug Logs
.DS_Store
Thumbs.db
.git
.gitignore
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Docker Specific Files
Dockerfile
docker-compose.yml
README.md

# Generated Assets
app/generated/prisma
EOF